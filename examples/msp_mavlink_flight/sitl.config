# Simulation-only MSP receiver and MAVLink telemetry on separate UARTs.
feature -RX_UDP
feature RX_MSP
feature TELEMETRY
feature -GPS
# UART1: MSP (mask 1), UART2: MAVLink telemetry (mask 512).
serial UART1 1 115200 57600 0 115200
serial UART2 512 115200 57600 57600 115200
# Match the Python RC channel order: roll, pitch, throttle, yaw, then AUX.
map AETR1234
mixer QUADX
set mag_hardware = NONE
# Use simulated barometric altitude, the profile disables GPS.
set altitude_source = BARO_ONLY
# AUX1 arms, AUX2 selects angle mode.
aux 0 0 0 1500 2100
aux 1 1 1 1500 2100
