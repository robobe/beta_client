# Simulation-only MAVLink receiver and telemetry.
feature -RX_UDP
feature -RX_MSP
feature RX_SERIAL
set serialrx_provider = MAVLINK
feature TELEMETRY
feature -GPS
serial UART1 1 115200 57600 0 115200
serial UART2 576 115200 57600 57600 115200
map AETR1234
mixer QUADX
set mag_hardware = NONE
set altitude_source = BARO_ONLY
# AUX1 arms, AUX2 selects angle mode.
aux 0 0 0 1500 2100
aux 1 1 1 1500 2100
